# copy to .env and fill in; .env is never committed
# WEIGHTS_DIR and DEVICE are left out on purpose: the Dockerfile sets them for the container
API_KEYS=change-me-to-a-long-random-string
MAX_BATCH_SIZE=8
MAX_WAIT_MS=10
# keep the queue under throughput x timeout: 0.64 issues/s x 30 s is about 19 on my Mac's CPU
MAX_QUEUE=16
REQUEST_TIMEOUT_S=30
LOG_LEVEL=INFO
# host ports for docker compose
API_PORT=8080
PROM_PORT=9090
